#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
                &kp TAB        &kp UP         &kp PG_UP
                &kp LEFT       &kp ENTER      &kp RIGHT
                &kp Z          &kp DOWN       &kp R
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            bindings = <
                &kp F13        &kp F14        &kp F15
                &kp F16        &kp F17        &kp F18
                &kp F19        &kp F20        &kp F21
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        select_layer {
            bindings = <
                &to 0          &rgb_ug RGB_HUI &rgb_ug RGB_HUD
                &rgb_ug RGB_SAI &rgb_ug RGB_TOG &rgb_ug RGB_SAD
                &rgb_ug RGB_BRI &rgb_ug RGB_BRD &to 1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
