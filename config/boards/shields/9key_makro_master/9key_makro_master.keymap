/*
 * 9key_makro_master — ZMK keymap
 *
 * Based on the reworked QMK layout philosophy:
 * nine keys, selector-driven context layers, simple visible layout.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE   0
#define SEL    1
#define WINDOW 2
#define TEXT   3
#define MEDIA  4
#define GAME   5
#define VSC    6
#define PROMPT 7
#define RGB    8

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &mo SEL         &kp UP_ARROW     &kp BACKSPACE
                &kp LEFT_ARROW  &kp ENTER        &kp RIGHT_ARROW
                &kp LC(Z)       &kp DOWN_ARROW   &kp LC(Y)
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        selector_layer {
            label = "SEL";
            bindings = <
                &trans     &to WINDOW  &to TEXT
                &to MEDIA  &to RGB     &to GAME
                &to VSC    &to BASE    &to PROMPT
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        window_layer {
            label = "WIN";
            bindings = <
                &mo SEL       &kp LC(L)       &kp LA(SPACE)
                &kp LA(LEFT)  &kp LG(TAB)     &kp LA(RIGHT)
                &kp LG(LEFT)  &kp LG(D)       &kp LG(RIGHT)
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        text_layer {
            label = "TEXT";
            bindings = <
                &mo SEL      &kp LC(A)       &kp LC(C)
                &kp HOME     &kp UP_ARROW    &kp END
                &kp LC(X)    &kp DOWN_ARROW  &kp LC(V)
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        media_layer {
            label = "MEDIA";
            bindings = <
                &mo SEL          &kp C_PREVIOUS  &kp C_NEXT
                &kp C_VOL_DN     &kp C_PP        &kp C_VOL_UP
                &kp C_REWIND     &kp C_MUTE      &kp C_FAST_FORWARD
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        game_layer {
            label = "GAME";
            bindings = <
                &mo SEL       &kp W           &kp ESCAPE
                &kp A         &kp S           &kp D
                &kp LSHIFT    &kp SPACE       &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        vsc_layer {
            label = "VSC";
            bindings = <
                &mo SEL       &kp LC(P)       &kp LC(LSHIFT)
                &kp LC(B)     &kp LC(G)       &kp LC(GRAVE)
                &kp LC(S)     &kp F5          &kp LC(F5)
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        prompt_layer {
            label = "PROMPT";
            bindings = <
                &mo SEL       &kp N1          &kp N2
                &kp N3        &kp N4          &kp N5
                &kp N6        &kp N7          &kp N8
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        rgb_layer {
            label = "RGB";
            bindings = <
                &mo SEL       &rgb_ug RGB_TOG &rgb_ug RGB_EFF
                &rgb_ug RGB_HUI &rgb_ug RGB_HUD &rgb_ug RGB_BRI
                &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_BRD
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
