            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key 7 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/oledKeyLabel7" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Key 8" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
                <EditText android:id="@+id/oledInput7" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="OLED label (5 chars)" android:maxLength="5" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/oledDesc7" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description" android:inputType="text|textCapSentences" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key 8 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/oledKeyLabel8" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Key 9" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
                <EditText android:id="@+id/oledInput8" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="OLED label (5 chars)" android:maxLength="5" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/oledDesc8" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description" android:inputType="text|textCapSentences" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save / Reset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oledResetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Reset to Firmware"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oledSaveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Labels" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
