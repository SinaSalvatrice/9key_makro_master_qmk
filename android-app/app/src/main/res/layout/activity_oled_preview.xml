                <EditText android:id="@+id/oledDesc3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description" android:inputType="text|textCapSentences" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key 4 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/oledKeyLabel4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Key 5" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
                <EditText android:id="@+id/oledInput4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="OLED label (5 chars)" android:maxLength="5" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/oledDesc4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description" android:inputType="text|textCapSentences" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key 5 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/oledKeyLabel5" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Key 6" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
                <EditText android:id="@+id/oledInput5" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="OLED label (5 chars)" android:maxLength="5" android:inputType="text|textNoSuggestions" />
                <EditText android:id="@+id/oledDesc5" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Description" android:inputType="text|textCapSentences" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key 6 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@+id/oledKeyLabel6" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Key 7" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
                <EditText android:id="@+id/oledInput6" android:layout_width="match_parent" android:layout_height="wrap_content"
