<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Key LEDs zone -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/ledKeyLabel"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Key LEDs"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
                <View android:id="@+id/ledKeyPreview"
                    android:layout_width="40dp" android:layout_height="24dp"
                    android:background="#808080" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Effect:" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
            <Spinner android:id="@+id/ledKeyEffect" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <include layout="@layout/include_led_hsv_speed"
                android:id="@+id/ledKeyHsvInc"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Gap LEDs zone -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/ledGapLabel"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gap LEDs"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
                <View android:id="@+id/ledGapPreview"
                    android:layout_width="40dp" android:layout_height="24dp"
                    android:background="#808080" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Effect:" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
            <Spinner android:id="@+id/ledGapEffect" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <include layout="@layout/include_led_hsv_speed"
                android:id="@+id/ledGapHsvInc"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Frame LEDs zone -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/ledFrameLabel"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Frame LEDs"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />
                <View android:id="@+id/ledFramePreview"
                    android:layout_width="40dp" android:layout_height="24dp"
                    android:background="#808080" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Effect:" android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
            <Spinner android:id="@+id/ledFrameEffect" android:layout_width="match_parent" android:layout_height="wrap_content" />

            <include layout="@layout/include_led_hsv_speed"
                android:id="@+id/ledFrameHsvInc"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Save / Reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ledResetButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="8dp"
            android:text="Reset Defaults"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ledSaveButton"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Save" />
    </LinearLayout>

</LinearLayout>
